{
  "name": "prompt-battle-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:fake": "ng serve -c fake",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test --grep @smoke",
    "e2e:screens": "playwright test --grep @screens",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "verify": "npm run lint && npm run format:check && npm run i18n:check && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@jsverse/transloco": "8.4.0",
    "canvas-confetti": "1.9.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
